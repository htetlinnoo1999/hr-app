# Base URL of the Staffly backend API.
# The `/api` prefix is docs-only — endpoints live at the root (e.g. /auth/login).
VITE_API_BASE_URL=http://localhost:8000

# Organization id whose user may access the Organizations management section
# (multi-org list + org CRUD). Leave empty to hide the section for everyone.
VITE_ORG_MANAGEMENT_ORGANIZATION_ID=
